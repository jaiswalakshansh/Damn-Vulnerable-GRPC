# ============================================================
# Damn Vulnerable gRPC — Example Environment File
# ------------------------------------------------------------
# Copy to `.env` and tweak to taste.  Every variable below is
# optional: the server falls back to sensible defaults.
# ============================================================

# --- Network ---
# Port the server listens on (container side is always 50051).
DVGRPC_PORT=50051

# Hostname the clients should connect to.
DVGRPC_HOST=localhost

# Convenience: combined host:port used by exploit scripts.
DVGRPC_HOST_PORT=localhost:50051

# --- Storage ---
# Root directory for runtime data (sqlite db, rsa keys, uploads, secrets).
# Default: `/app` inside Docker, `./.dvgrpc` when running locally.
# DVGRPC_ROOT=./.dvgrpc
# DB_PATH=./.dvgrpc/data/dvgrpc.db

# --- Logging ---
# DEBUG | INFO | WARNING | ERROR
DVGRPC_LOG_LEVEL=INFO

# --- Intentionally insecure defaults (override only if you know why) ---
# DVGRPC_JWT_SECRET=supersecretkey123
# DVGRPC_ADMIN_USER=admin
# DVGRPC_ADMIN_PASS=admin123

# --- Challenge tuning ---
# Cap for the streaming-DoS challenge.  The server will *accept* up to this
# many messages per stream (intentionally high to demonstrate the attack).
# DVGRPC_MAX_STREAM_MESSAGES=100000
